---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Clínica Dental josstech_xd</title>
  </head>
  <body
    class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between"
  >
    <!-- 1. Header con botones de navegación e información superior -->
    <Header />

    <!-- 2. Navbar que proyecta la información del botón presionado -->
    <Navbar>
      <slot />
    </Navbar>

    <!-- 3. Pie de página estático -->
    <Footer />
  </body>
</html>

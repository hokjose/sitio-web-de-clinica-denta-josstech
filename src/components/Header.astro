---
import "tailwindcss";
---

<header class="w-full bg-white border-b border-slate-200 sticky top-0 z-50">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 md:py-0 md:h-16 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-0"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div
        class="w-10 h-10 bg-white border border-slate-200 rounded-xl shadow-sm p-1 flex items-center justify-center overflow-hidden transition-all group-hover:border-sky-300"
      >
        <img
          src="/imagenes/josstech_logo.png"
          alt="Logo"
          class="w-full h-full object-cover rounded-lg"
        />
      </div>
      <div>
        <span
          class="font-bold text-slate-900 text-lg block leading-none group-hover:text-sky-700"
          >josstech_xd</span
        >
        <span class="text-[10px] text-slate-500 font-medium"
          >Clínica Dental</span
        >
      </div>
    </a>

    <!-- Botones hechos 100% en HTML/Astro puro (Sin variables TypeScript) -->
    <nav
      class="flex items-center gap-1 bg-slate-100 p-1 rounded-full text-xs font-semibold overflow-x-auto max-w-full"
    >
      <a
        href="/"
        class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all whitespace-nowrap"
        >Inicio</a
      >
      <a
        href="/Nosotros"
        class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all whitespace-nowrap"
        >Nosotros</a
      >
      <a
        href="/Servicios"
        class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all whitespace-nowrap"
        >Servicios</a
      >
      <a
        href="/Contacto"
        class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all whitespace-nowrap"
        >Contacto</a
      >
    </nav>

    <!-- Botón de Pedir Cita -->
    <div class="flex items-center gap-2">
      <a
        href="/Contacto"
        class="bg-sky-700 hover:bg-sky-800 text-white text-xs font-semibold px-4 py-2 sm:py-2.5 rounded-lg flex items-center gap-2 shadow-sm transition-colors cursor-pointer whitespace-nowrap"
      >
        <span>📅</span> Pedir Cita
      </a>
    </div>
  </div>
</header>

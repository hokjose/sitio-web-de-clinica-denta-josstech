---
import "tailwindcss";
---

<footer
  class="bg-slate-900 text-slate-400 text-xs py-8 border-t border-slate-800"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6"
  >
    <!-- Información de la Clínica y Enlace de Ubicación -->
    <div class="text-center md:text-left space-y-1">
      <p class="font-bold text-white text-sm">josstech_xd Clínica Dental</p>
      <p class="text-[11px] text-slate-400">
        © 2026 Todos los derechos reservados.
      </p>

      <!-- Enlace directo para ver ubicación -->
      <a
        href="https://maps.google.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-sky-400 hover:text-sky-300 font-medium text-[11px] pt-1 transition-colors cursor-pointer"
      >
        <span>📍</span> Ver ubicación
      </a>
    </div>

    <!-- Sección de Redes Sociales -->
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <span class="text-slate-300 text-xs font-medium">
        Visita nuestras redes sociales:
      </span>

      <!-- Enlaces directos en HTML/Astro puro -->
      <div class="flex items-center gap-2">
        <a
          href="https://www.facebook.com/joss.mamani.18/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 bg-slate-800 hover:bg-sky-600 text-slate-200 hover:text-white rounded-lg font-semibold text-xs transition-all border border-slate-700 shadow-sm cursor-pointer select-none"
          >Facebook</a
        >
        <a
          href="https://www.instagram.com/jossmamani/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 bg-slate-800 hover:bg-sky-600 text-slate-200 hover:text-white rounded-lg font-semibold text-xs transition-all border border-slate-700 shadow-sm cursor-pointer select-none"
          >Instagram</a
        >
        <a
          href="https://www.tiktok.com/@jossmamani223"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 bg-slate-800 hover:bg-sky-600 text-slate-200 hover:text-white rounded-lg font-semibold text-xs transition-all border border-slate-700 shadow-sm cursor-pointer select-none"
          >TikTok</a
        >
      </div>
    </div>
  </div>
</footer>
